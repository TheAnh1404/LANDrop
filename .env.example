# ==============================================================================
# LANDrop Backend - Environment Configuration Template
# Java JDBC/HikariCP + PostgreSQL; Prisma schema is a reference
#
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Populate DATABASE_URL with your actual Neon PostgreSQL connection string.
# 3. DO NOT commit the .env file containing real credentials to version control.
# ==============================================================================

# Neon PostgreSQL connection string (Pooled connection for serverless / runtime queries)
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional direct connection for schema tooling (bypasses PgBouncer pooler).
# Java SQL migrations are applied with com.landrop.database.DatabaseCli.
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Database Connection Pool Settings (HikariCP)
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN_IDLE=2
DATABASE_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=600000
DATABASE_MAX_LIFETIME_MS=1800000

# ==============================================================================
# LANDrop Authentication & User Sessions
# ==============================================================================

# Authentication HTTP Server Port
AUTH_PORT=3000
REALTIME_PORT=3001
BIND_HOST=0.0.0.0

# Secret keys for signing JSON Web Tokens (HMAC-SHA256, minimum 256 bits recommended)
JWT_ACCESS_SECRET="replace-with-a-secure-random-256-bit-secret-for-access-tokens"
JWT_REFRESH_SECRET="replace-with-a-secure-random-256-bit-secret-for-refresh-tokens"

# Token Expiration Durations (supports raw seconds, or suffix 's', 'm', 'h', 'd')
# 15 minutes = 900 seconds
JWT_ACCESS_EXPIRES_IN="900"
# 7 days = 604800 seconds
JWT_REFRESH_EXPIRES_IN="604800"

# ==============================================================================
# LANDrop Integrated Server
# ==============================================================================

# Server Network Host (0.0.0.0 listens on all LAN network interfaces)
HOST="0.0.0.0"

# Server Ports
PORT=3000
WS_PORT=3001

# Protocol Version (Canonical = 1)
PROTOCOL_VERSION=1

# Heartbeat & Keepalive Timing
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=45000

# Logging Level (INFO, WARN, ERROR, DEBUG)
LOG_LEVEL="INFO"

# Docker Compose local deployment (set unique values before running)
POSTGRES_PASSWORD="replace-with-a-unique-postgres-password"
ADMIN_PASSWORD="replace-with-a-unique-admin-password-at-least-12-characters"

