<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.landrop.ui.controllers.LoginController" styleClass="auth-page">
    <VBox alignment="CENTER" spacing="20.0" maxWidth="440.0" styleClass="auth-container">
        <VBox alignment="CENTER" spacing="6.0">
            <Label text="LANDrop" styleClass="app-title" style="-fx-font-size: 30px;"/>
            <Label text="Sign in to your account" styleClass="page-subtitle"/>
        </VBox>
        <VBox styleClass="card" spacing="14.0" maxWidth="440.0">
            <Label text="Welcome back" styleClass="card-title"/>
            <VBox styleClass="form-group">
                <Label text="Email" styleClass="form-label"/>
                <TextField fx:id="emailField" promptText="you@example.com" styleClass="text-input-field"/>
            </VBox>
            <VBox styleClass="form-group">
                <Label text="Password" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="Your password" styleClass="text-input-field"/>
            </VBox>
            <Label fx:id="errorLabel" wrapText="true" styleClass="auth-error"/>
            <Button fx:id="submitButton" text="Sign in" maxWidth="Infinity" styleClass="primary-button" onAction="#onSubmit"/>
            <HBox alignment="CENTER" spacing="4.0">
                <Label text="New to LANDrop?" styleClass="page-subtitle"/>
                <Hyperlink fx:id="registerLink" text="Create an account" onAction="#onRegister"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
