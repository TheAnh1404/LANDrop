<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.landrop.ui.controllers.LoginController" styleClass="auth-page">
    <VBox alignment="CENTER" spacing="20.0" maxWidth="440.0" styleClass="auth-container">
        <VBox alignment="CENTER" spacing="6.0">
            <Label text="LANDrop" styleClass="app-title" style="-fx-font-size: 30px;"/>
            <Label text="Đăng nhập tài khoản hoặc dùng chế độ mạng nội bộ" styleClass="page-subtitle"/>
        </VBox>
        <VBox styleClass="card" spacing="14.0" maxWidth="440.0">
            <Label text="Chào mừng trở lại" styleClass="card-title"/>
            <VBox styleClass="form-group">
                <Label text="Email hoặc Tên đăng nhập" styleClass="form-label"/>
                <TextField fx:id="emailField" promptText="email@example.com hoặc username" styleClass="text-input-field"/>
            </VBox>
            <VBox styleClass="form-group">
                <Label text="Mật khẩu" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu" styleClass="text-input-field"/>
            </VBox>
            <Label fx:id="errorLabel" wrapText="true" styleClass="auth-error"/>
            <Button fx:id="submitButton" text="Đăng nhập" maxWidth="Infinity" styleClass="primary-button" onAction="#onSubmit"/>
            
            <HBox alignment="CENTER" spacing="4.0">
                <Label text="Chưa có tài khoản?" styleClass="page-subtitle"/>
                <Hyperlink fx:id="registerLink" text="Tạo tài khoản mới" onAction="#onRegister"/>
            </HBox>

            <Separator style="-fx-padding: 4px 0;"/>

            <!-- Nút vào thẳng chế độ Offline LAN P2P không cần tài khoản -->
            <Button fx:id="offlineModeButton" text="⚡ Dùng chế độ mạng nội bộ P2P (Không cần tài khoản)"
                    maxWidth="Infinity" styleClass="secondary-button" onAction="#onContinueOffline"
                    style="-fx-font-size: 12px; -fx-text-fill: #4338ca; -fx-font-weight: bold; -fx-padding: 8px 12px;"/>

            <HBox alignment="CENTER" spacing="8.0" style="-fx-padding: 8px 0 0 0; -fx-border-color: #f1f5f9; -fx-border-width: 1px 0 0 0;">
                <Label fx:id="serverAddressLabel" text="🟢 Máy chủ: Đang kết nối" style="-fx-font-size: 11px; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                <Hyperlink text="Dò lại máy chủ" onAction="#onAutoDetectServer" style="-fx-font-size: 11px; -fx-text-fill: #6366f1;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
