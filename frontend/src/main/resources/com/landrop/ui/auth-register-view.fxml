<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.landrop.ui.controllers.RegisterController" styleClass="auth-page">
    <VBox alignment="CENTER" spacing="20.0" maxWidth="440.0" styleClass="auth-container">
        <VBox alignment="CENTER" spacing="6.0">
            <Label text="LANDrop" styleClass="app-title" style="-fx-font-size: 30px;"/>
            <Label text="Create your account" styleClass="page-subtitle"/>
        </VBox>
        <VBox styleClass="card" spacing="12.0" maxWidth="440.0">
            <Label text="Get started" styleClass="card-title"/>
            <VBox styleClass="form-group">
                <Label text="Username" styleClass="form-label"/>
                <TextField fx:id="usernameField" promptText="your-username" styleClass="text-input-field"/>
            </VBox>
            <VBox styleClass="form-group">
                <Label text="Display name" styleClass="form-label"/>
                <TextField fx:id="displayNameField" promptText="How others see you" styleClass="text-input-field"/>
            </VBox>
            <VBox styleClass="form-group">
                <Label text="Email" styleClass="form-label"/>
                <TextField fx:id="emailField" promptText="you@example.com" styleClass="text-input-field"/>
            </VBox>
            <HBox spacing="12.0">
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                    <Label text="Password" styleClass="form-label"/>
                    <PasswordField fx:id="passwordField" promptText="At least 8 characters" styleClass="text-input-field"/>
                </VBox>
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                    <Label text="Confirm" styleClass="form-label"/>
                    <PasswordField fx:id="confirmationField" promptText="Repeat password" styleClass="text-input-field"/>
                </VBox>
            </HBox>
            <Label fx:id="errorLabel" wrapText="true" styleClass="auth-error"/>
            <Button fx:id="submitButton" text="Create account" maxWidth="Infinity" styleClass="primary-button" onAction="#onSubmit"/>
            <HBox alignment="CENTER" spacing="4.0">
                <Label text="Already have an account?" styleClass="page-subtitle"/>
                <Hyperlink fx:id="loginLink" text="Sign in" onAction="#onLogin"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
