<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.landrop.ui.controllers.ChatController"
      spacing="0" styleClass="page-container"
      style="-fx-padding: 12px 16px 16px 16px; -fx-background-color: #f8fafc;">

    <!-- 1. Cột Trái: Danh sách Kênh (Channels Sidebar) -->
    <VBox prefWidth="230" minWidth="200" maxWidth="260" styleClass="channel-sidebar" spacing="10">
        <padding>
            <Insets top="10" right="12" bottom="10" left="12"/>
        </padding>

        <VBox spacing="3">
            <Label text="NHÓM / WORKSPACE" styleClass="sidebar-heading" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
            <Label fx:id="workspaceNameLabel" text="Workspace" styleClass="card-title" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        </VBox>

        <Separator style="-fx-padding: 2px 0;"/>

        <HBox alignment="CENTER_LEFT">
            <Label text="KÊNH TRÒ CHUYỆN" styleClass="sidebar-heading" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="channel-list-scroll" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="channelListContainer" spacing="4"/>
        </ScrollPane>

        <!-- Hộp tạo kênh mới -->
        <VBox fx:id="createChannelBox" spacing="6" styleClass="create-channel-box"
              style="-fx-background-color: #f1f5f9; -fx-padding: 10px; -fx-background-radius: 8px;">
            <Label text="+ Thêm kênh mới" styleClass="workspace-item-name" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
            <TextField fx:id="channelNameInput" promptText="Tên kênh (vd: tai-lieu)" styleClass="text-input-field" style="-fx-font-size: 12px;"/>
            <TextField fx:id="channelDescriptionInput" promptText="Mô tả (tuỳ chọn)" styleClass="text-input-field" style="-fx-font-size: 12px;"/>
            <Button fx:id="createChannelButton" text="Tạo kênh" onAction="#onCreateChannel" styleClass="secondary-button" maxWidth="Infinity"/>
        </VBox>
    </VBox>

    <!-- 2. Cột Giữa: Khung Trò Chuyện & Chia sẻ File Lớn (Chat & File Share Area) -->
    <VBox styleClass="chat-container" HBox.hgrow="ALWAYS" spacing="6" style="-fx-padding: 0 12px 0 12px;">
        <!-- Header kênh chat -->
        <HBox alignment="CENTER_LEFT" styleClass="chat-header"
              style="-fx-padding: 10px 14px; -fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
            <VBox spacing="2">
                <Label fx:id="channelTitleLabel" text="Chọn một kênh" styleClass="card-title" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="channelDescriptionLabel" text="Kênh trao đổi thông tin và chia sẻ tài liệu trong nhóm" styleClass="page-subtitle" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <HBox alignment="CENTER" spacing="6" style="-fx-background-color: #f8fafc; -fx-padding: 4px 10px; -fx-background-radius: 16px; -fx-border-color: #e2e8f0; -fx-border-radius: 16px;">
                    <Circle fx:id="connectionDot" radius="4.5" fill="#94a3b8"/>
                    <Label fx:id="connectionStatusLabel" text="Disconnected" styleClass="page-subtitle" style="-fx-font-size: 11px;"/>
                </HBox>
                <Button fx:id="openFolderButton" text="📁 Mở Kho Tài Liệu" styleClass="secondary-button" onAction="#onOpenDocumentsVault" style="-fx-font-size: 12px;"/>
            </HBox>
        </HBox>

        <Label fx:id="errorLabel" styleClass="chat-error-label" wrapText="true"/>

        <!-- Nút tải tin nhắn cũ hơn -->
        <Button fx:id="loadOlderButton" text="↑ Tải tin nhắn cũ hơn" onAction="#onLoadOlder" styleClass="message-action-button" maxWidth="Infinity"/>

        <!-- Danh sách tin nhắn -->
        <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
            <ScrollPane fx:id="chatScrollPane" fitToWidth="true" styleClass="chat-messages-scroll"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="messagesContainer" styleClass="chat-messages-container" spacing="10" style="-fx-padding: 14px;"/>
            </ScrollPane>
            <VBox fx:id="emptyMessagesContainer" alignment="CENTER" maxWidth="420" maxHeight="160" styleClass="empty-state-box" spacing="6">
                <Label text="💬 Chưa có tin nhắn nào" styleClass="empty-state-title" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="Hãy bắt đầu cuộc trò chuyện hoặc kéo thả file lớn vào đây để chia sẻ với nhóm." styleClass="empty-state-desc" wrapText="true" style="-fx-text-alignment: center; -fx-text-fill: #64748b;"/>
            </VBox>
        </StackPane>

        <!-- Thanh trả lời (Reply Bar) -->
        <HBox fx:id="replyBar" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false" styleClass="reply-bar"
              style="-fx-background-color: #e0e7ff; -fx-padding: 6px 12px; -fx-background-radius: 6px;">
            <Label text="↩" style="-fx-font-size: 14px; -fx-text-fill: #4338ca;"/>
            <Label fx:id="replyLabel" HBox.hgrow="ALWAYS" style="-fx-font-size: 12px; -fx-text-fill: #3730a3;"/>
            <Button text="✕" onAction="#onCancelReply" styleClass="message-action-button"/>
        </HBox>

        <!-- Thanh xem trước file đính kèm lớn (Attachment Preview Bar) -->
        <HBox fx:id="attachmentBar" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false"
              style="-fx-background-color: #ecfdf5; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-color: #a7f3d0; -fx-border-radius: 6px;">
            <Label fx:id="attachmentIconLabel" text="📦" style="-fx-font-size: 18px;"/>
            <VBox HBox.hgrow="ALWAYS" spacing="1">
                <Label fx:id="attachmentNameLabel" text="file_name.zip" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #065f46;"/>
                <Label fx:id="attachmentSizeLabel" text="Dung lượng: 0 B" style="-fx-font-size: 11px; -fx-text-fill: #047857;"/>
            </VBox>
            <Button text="✕ Huỷ đính kèm" onAction="#onCancelAttachment" styleClass="message-action-button" style="-fx-text-fill: #b91c1c;"/>
        </HBox>

        <!-- Thanh nhập tin nhắn và nút đính kèm file -->
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="chat-input-bar"
              style="-fx-padding: 8px 12px; -fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
            <!-- Nút đính kèm tệp lớn -->
            <Button fx:id="attachFileButton" text="📎 Đính kèm tệp" onAction="#onAttachFile"
                    styleClass="secondary-button" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>

            <!-- Ô nhập nội dung tin nhắn -->
            <TextField fx:id="messageInput" promptText="Nhập tin nhắn... (hoặc kéo thả file vào khung chat, Enter để gửi)"
                       onAction="#onSendMessage" styleClass="text-input-field" HBox.hgrow="ALWAYS"/>

            <!-- Nút Gửi -->
            <Button fx:id="sendButton" text="Gửi" onAction="#onSendMessage"
                    styleClass="primary-button" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6px 16px;"/>
        </HBox>
    </VBox>

    <!-- 3. Cột Phải: Danh Sách Thành Viên & Thiết Bị Trực Tuyến trong Nhóm (Group Members Sidebar) -->
    <VBox prefWidth="220" minWidth="190" maxWidth="250" styleClass="channel-sidebar" spacing="10"
          style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
        <padding>
            <Insets top="12" right="12" bottom="12" left="12"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="6">
            <Label fx:id="membersHeaderLabel" text="THÀNH VIÊN (0)" styleClass="sidebar-heading"
                   style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>

        <Separator style="-fx-padding: 2px 0;"/>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="channel-list-scroll"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="membersListContainer" spacing="6"/>
        </ScrollPane>

        <!-- Thống kê chia sẻ mạng LAN -->
        <VBox spacing="4" style="-fx-background-color: #f8fafc; -fx-padding: 10px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;">
            <Label text="⚡ Mạng P2P LAN" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Label text="File lớn được truyền trực tiếp qua cổng mạng LAN nội bộ, tốc độ tối đa không qua máy chủ."
                   wrapText="true" style="-fx-font-size: 10.5px; -fx-text-fill: #64748b;"/>
        </VBox>
    </VBox>
</HBox>
