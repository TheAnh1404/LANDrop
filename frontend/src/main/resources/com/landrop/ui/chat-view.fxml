<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.landrop.ui.controllers.ChatController" spacing="0" styleClass="page-container" style="-fx-padding: 16px 24px 20px 24px;">
  <VBox prefWidth="220" styleClass="channel-sidebar">
    <Label fx:id="workspaceNameLabel" text="Workspace" styleClass="card-title"/>
    <Label text="CHANNELS" styleClass="sidebar-heading"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="channel-list-scroll"><VBox fx:id="channelListContainer" spacing="3"/></ScrollPane>
    <VBox fx:id="createChannelBox" spacing="6" styleClass="create-channel-box"><Label text="Create channel" styleClass="workspace-item-name"/><TextField fx:id="channelNameInput" promptText="channel-name" styleClass="text-input-field"/><TextField fx:id="channelDescriptionInput" promptText="Description (optional)" styleClass="text-input-field"/><Button fx:id="createChannelButton" text="Create" onAction="#onCreateChannel" styleClass="secondary-button"/></VBox>
  </VBox>
  <VBox styleClass="chat-container" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT" styleClass="chat-header"><VBox spacing="2"><Label fx:id="channelTitleLabel" text="Select a channel" styleClass="card-title"/><Label fx:id="channelDescriptionLabel" styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><HBox spacing="6" alignment="CENTER_RIGHT"><Circle fx:id="connectionDot" radius="4" fill="#94a3b8"/><Label fx:id="connectionStatusLabel" text="Disconnected" styleClass="page-subtitle"/></HBox></HBox>
    <Label fx:id="errorLabel" styleClass="chat-error-label"/>
    <Button fx:id="loadOlderButton" text="Load older messages" onAction="#onLoadOlder" styleClass="message-action-button" maxWidth="Infinity"/>
    <StackPane VBox.vgrow="ALWAYS"><ScrollPane fx:id="chatScrollPane" fitToWidth="true" styleClass="chat-messages-scroll"><VBox fx:id="messagesContainer" styleClass="chat-messages-container"/></ScrollPane><VBox fx:id="emptyMessagesContainer" alignment="CENTER" maxWidth="400" maxHeight="150" styleClass="empty-state-box"><Label text="No messages yet." styleClass="empty-state-title"/><Label text="Start the channel conversation below." styleClass="empty-state-desc"/></VBox></StackPane>
    <HBox fx:id="replyBar" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false" styleClass="reply-bar"><Label fx:id="replyLabel" HBox.hgrow="ALWAYS"/><Button text="Cancel" onAction="#onCancelReply" styleClass="message-action-button"/></HBox>
    <HBox alignment="CENTER_LEFT" styleClass="chat-input-bar"><TextField fx:id="messageInput" promptText="Message this channel… (Enter to send)" onAction="#onSendMessage" styleClass="text-input-field" HBox.hgrow="ALWAYS"/><Button fx:id="sendButton" text="Send" onAction="#onSendMessage" styleClass="primary-button"/></HBox>
  </VBox>
</HBox>
