<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.landrop.ui.controllers.MainController"
            prefWidth="1200.0" prefHeight="760.0" minWidth="1000.0" minHeight="650.0"
            styleClass="root">

    <!-- 1. Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <!-- Brand -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="LANDrop" styleClass="app-title"/>
                <Label text="v1" styleClass="app-version-badge"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Status Indicator and Current Peer Identity -->
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <HBox styleClass="status-indicator-box" alignment="CENTER_LEFT">
                    <Circle fx:id="topDiscoveryDot" radius="4.0" fill="#94a3b8"/>
                    <Label fx:id="topDiscoveryStatusLabel" text="Discovery Connecting..." styleClass="status-text"/>
                </HBox>

                <Label fx:id="topPeerIdentityBadge" text="Peer" styleClass="topbar-identity-badge"/>
            </HBox>
        </HBox>
    </top>

    <!-- 2. Center (Sidebar + Main Content) -->
    <center>
        <BorderPane>
            <!-- Sidebar Navigation -->
            <left>
                <VBox styleClass="sidebar">
                    <Label text="NAVIGATION" styleClass="sidebar-heading"/>
                    
                    <Button fx:id="dashboardNavBtn" text="⊞  Dashboard" maxWidth="Infinity"
                            styleClass="sidebar-btn" onAction="#onDashboardNavClicked"/>

                    <Button fx:id="peersNavBtn" text="👥  Peers" maxWidth="Infinity"
                            styleClass="sidebar-btn" onAction="#onPeersNavClicked"/>

                    <Button fx:id="chatNavBtn" text="💬  Chat" maxWidth="Infinity"
                            styleClass="sidebar-btn" onAction="#onChatNavClicked"/>

                    <Button fx:id="transfersNavBtn" text="📁  Transfers" maxWidth="Infinity"
                            styleClass="sidebar-btn" onAction="#onTransfersNavClicked"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Separator style="-fx-padding: 6px 0;"/>

                    <Button fx:id="settingsNavBtn" text="⚙  Settings" maxWidth="Infinity"
                            styleClass="sidebar-btn" onAction="#onSettingsNavClicked"/>
                </VBox>
            </left>

            <!-- Dynamic Content Area -->
            <center>
                <StackPane fx:id="contentArea" style="-fx-background-color: #f8fafc;"/>
            </center>
        </BorderPane>
    </center>

    <!-- 3. Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="statusbar">
            <Label fx:id="bottomPeerStatusLabel" text="Peer: Initializing..." styleClass="statusbar-item"/>
            <Label text="|" styleClass="statusbar-separator"/>
            <Label fx:id="bottomDiscoveryStatusLabel" text="Discovery: Initializing..." styleClass="statusbar-item"/>
            <Label text="|" styleClass="statusbar-separator"/>
            <Label fx:id="bottomP2pStatusLabel" text="P2P: Disconnected" styleClass="statusbar-item"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="bottomProtocolLabel" text="Protocol: v1" styleClass="statusbar-item"/>
        </HBox>
    </bottom>
</BorderPane>
