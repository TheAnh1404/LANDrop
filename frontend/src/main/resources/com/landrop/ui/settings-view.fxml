<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.landrop.ui.controllers.SettingsController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="20.0" styleClass="page-container" maxWidth="750.0">
        <!-- Header -->
        <VBox styleClass="page-header" spacing="4.0">
            <Label text="Cài đặt hệ thống" styleClass="page-title"/>
            <Label text="Thông tin tài khoản, thiết bị, kết nối máy chủ và mạng nội bộ" styleClass="page-subtitle"/>
        </VBox>

        <!-- User & Device Card -->
        <VBox styleClass="card" spacing="14.0">
            <Label fx:id="signedInLabel" text="Signed in as:"/>
            <Label fx:id="enrolledDeviceLabel" text="Device:" wrapText="true"/>
            <TextField fx:id="renameDeviceField" promptText="Device name"/>
            <Button fx:id="renameDeviceButton" text="Đổi tên thiết bị" onAction="#onRenameDevice"/>
        </VBox>

        <!-- Server Connection Card (Auto-managed) -->
        <VBox styleClass="card" spacing="14.0">
            <Label text="Kết nối máy chủ LANDrop (Tự động quản lý)" styleClass="card-title"/>
            
            <VBox styleClass="form-group">
                <Label text="API URL (Tự động phát hiện)" styleClass="form-label"/>
                <TextField fx:id="apiUrlField" editable="false" styleClass="form-readonly-value"/>
            </VBox>
            <VBox styleClass="form-group">
                <Label text="WebSocket URL (Tự động phát hiện)" styleClass="form-label"/>
                <TextField fx:id="wsUrlField" editable="false" styleClass="form-readonly-value"/>
            </VBox>
            
            <Label fx:id="serverStatusLabel" text="Server: Disconnected" wrapText="true" style="-fx-text-fill: #64748b;"/>

            <HBox spacing="10.0">
                <Button text="🔍 Tự động dò tìm lại máy chủ" styleClass="primary-button" onAction="#onAutoDetectServer"/>
                <Button text="Kiểm tra máy chủ" styleClass="secondary-button" onAction="#onCheckServerClicked"/>
                <Button text="Kết nối lại" styleClass="secondary-button" onAction="#onReconnectClicked"/>
                <Button text="Gửi thử echo" styleClass="secondary-button" onAction="#onEchoClicked"/>
            </HBox>

            <HBox spacing="16.0">
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS"><Label text="Server Name" styleClass="form-label"/><TextField fx:id="serverNameField" editable="false" styleClass="form-readonly-value"/></VBox>
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS"><Label text="Server Address" styleClass="form-label"/><TextField fx:id="serverAddressField" editable="false" styleClass="form-readonly-value"/></VBox>
            </HBox>
            <HBox spacing="16.0">
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS"><Label text="Connection ID" styleClass="form-label"/><TextField fx:id="connectionIdField" editable="false" styleClass="form-readonly-value"/></VBox>
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS"><Label text="Client Instance ID" styleClass="form-label"/><TextField fx:id="clientInstanceIdField" editable="false" styleClass="form-readonly-value"/></VBox>
            </HBox>
            <HBox spacing="16.0">
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS"><Label text="Device Name" styleClass="form-label"/><TextField fx:id="deviceNameField" editable="false" styleClass="form-readonly-value"/></VBox>
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS"><Label text="Client Version" styleClass="form-label"/><TextField fx:id="clientVersionField" editable="false" styleClass="form-readonly-value"/></VBox>
            </HBox>
            <HBox spacing="16.0">
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS"><Label text="State" styleClass="form-label"/><TextField fx:id="stateDiagnosticField" editable="false" styleClass="form-readonly-value"/></VBox>
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS"><Label text="Server Version / Protocol" styleClass="form-label"/><TextField fx:id="serverProtocolField" editable="false" styleClass="form-readonly-value"/></VBox>
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS"><Label text="Last Heartbeat / Retry" styleClass="form-label"/><TextField fx:id="heartbeatDiagnosticField" editable="false" styleClass="form-readonly-value"/></VBox>
            </HBox>
            <Label text="Các thông số kết nối và cổng mạng được hệ thống tự động phát hiện và định tuyến." wrapText="true" styleClass="page-subtitle"/>
        </VBox>

        <!-- Identity Card -->
        <VBox styleClass="card" spacing="14.0">
            <Label text="Định danh mạng nội bộ (Peer Identity)" styleClass="card-title"/>
            
            <VBox styleClass="form-group">
                <Label text="Peer ID (UUID)" styleClass="form-label"/>
                <TextField fx:id="peerIdField" editable="false" styleClass="form-readonly-value"/>
            </VBox>

            <VBox styleClass="form-group">
                <Label text="Tên hiển thị" styleClass="form-label"/>
                <TextField fx:id="displayNameField" editable="false" styleClass="form-readonly-value"/>
            </VBox>
        </VBox>

        <!-- Network Card (Read-only diagnostics) -->
        <VBox styleClass="card" spacing="14.0">
            <Label text="Thông số mạng (Tự động cấu hình)" styleClass="card-title"/>

            <HBox spacing="16.0">
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                    <Label text="Cổng lắng nghe P2P cục bộ" styleClass="form-label"/>
                    <TextField fx:id="localPortField" editable="false" styleClass="form-readonly-value"/>
                </VBox>
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                    <Label text="Địa chỉ Host công bố" styleClass="form-label"/>
                    <TextField fx:id="advertisedHostField" editable="false" styleClass="form-readonly-value"/>
                </VBox>
            </HBox>

            <HBox spacing="16.0">
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                    <Label text="Máy chủ dò tìm (Host)" styleClass="form-label"/>
                    <TextField fx:id="discoveryHostField" editable="false" styleClass="form-readonly-value"/>
                </VBox>
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                    <Label text="Cổng máy chủ dò tìm" styleClass="form-label"/>
                    <TextField fx:id="discoveryPortField" editable="false" styleClass="form-readonly-value"/>
                </VBox>
            </HBox>

            <HBox spacing="16.0">
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                    <Label text="Phiên bản giao thức" styleClass="form-label"/>
                    <TextField fx:id="protocolVersionField" editable="false" styleClass="form-readonly-value"/>
                </VBox>
                <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                    <Label text="Chu kỳ gửi nhịp tim (Heartbeat)" styleClass="form-label"/>
                    <TextField fx:id="heartbeatIntervalField" editable="false" styleClass="form-readonly-value"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
