<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.landrop.ui.controllers.TransfersController" spacing="12" VBox.vgrow="ALWAYS" styleClass="page-container" style="-fx-padding: 16px 24px 20px 24px;">
  <HBox alignment="CENTER_LEFT" spacing="10"><VBox HBox.hgrow="ALWAYS"><Label fx:id="workspaceNameLabel" text="Files" styleClass="page-title"/><Label text="Workspace files and direct LAN transfers" styleClass="page-subtitle"/></VBox><Button fx:id="selectFileButton" text="Select File &amp; Send" onAction="#onSelectFile" styleClass="primary-button"/><Button fx:id="newFolderButton" text="New Folder" onAction="#onNewFolder" styleClass="secondary-button"/></HBox>
  <HBox alignment="CENTER_LEFT" spacing="8" styleClass="file-breadcrumb"><Button fx:id="rootButton" text="Files" onAction="#onRoot" styleClass="message-action-button"/><Label fx:id="breadcrumbLabel" text="Files"/></HBox>
  <Label fx:id="errorLabel" styleClass="chat-error-label"/><Label fx:id="successLabel" styleClass="file-success-label"/>
  <SplitPane dividerPositions="0.70" VBox.vgrow="ALWAYS"><items>
    <VBox spacing="8"><ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="chat-messages-scroll"><VBox spacing="6"><Label text="FOLDERS" styleClass="sidebar-heading"/><VBox fx:id="foldersContainer" spacing="4"/><Label text="FILES" styleClass="sidebar-heading"/><VBox fx:id="filesContainer" spacing="4"/><VBox fx:id="emptyFilesContainer" alignment="CENTER" styleClass="empty-state-box"><Label text="This folder is empty" styleClass="empty-state-title"/><Label text="Create a folder or select a file to start." styleClass="empty-state-desc"/></VBox></VBox></ScrollPane></VBox>
    <VBox spacing="10" styleClass="file-details-pane"><Label text="Details" styleClass="card-title"/><Label fx:id="detailsLabel" text="Select a file to see metadata." wrapText="true"/><Separator/><Label text="Recent LAN transfers" styleClass="card-title"/><ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"><VBox fx:id="transfersContainer" spacing="6"/></ScrollPane></VBox>
  </items></SplitPane>
</VBox>
