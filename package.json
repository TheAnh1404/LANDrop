{
  "name": "landrop-development-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Development and server lifecycle commands for LANDrop",
  "scripts": {
    "p2p:build": "node scripts/build-p2p.mjs",
    "p2p:check": "node scripts/build-p2p.mjs --check",
    "test:p2p:browser": "node scripts/p2p-browser-smoke.mjs",
    "test:p2p:live": "node scripts/p2p-live-browser.mjs",
    "test:p2p:chat": "node scripts/p2p-chat-benchmark.mjs",
    "server:secure": "node scripts/lan-proxy.mjs",
    "server": "node scripts/start-server.mjs",
    "server:desktop": "node scripts/start-server.mjs",
    "server:headless": "node scripts/start-server.mjs --headless",
    "server:backend": "node scripts/start-server.mjs --backend-only",
    "server:test": "node --test scripts/start-server.test.mjs",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "web": "npm --prefix frontend run dev",
    "client": "npm --prefix frontend run dev",
    "client:ui": "npm --prefix frontend run dev",
    "test": "node --test scripts/*.test.mjs",
    "test:realtime:lan": "node scripts/realtime-lan-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
