{
  "name": "landrop-development-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Development and server lifecycle commands for LANDrop",
  "scripts": {
    "server": "node scripts/start-server.mjs",
    "server:backend": "node scripts/start-server.mjs --backend-only",
    "server:admin": "node scripts/start-server.mjs --admin-only",
    "server:test": "node --test scripts/start-server.test.mjs",
    "client": "node scripts/start-client.mjs",
    "client:ui": "node scripts/start-client.mjs --ui-only",
    "client:test": "node --test scripts/start-client.test.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
